        "accentColor": { "type": "string", "minLength": 4, "maxLength": 20 },
        "image": { "type": "string", "maxLength": 350000 },
        "imageAlt": { "type": "string", "maxLength": 240 },
        "imageFit": { "type": "string", "enum": ["cover", "contain"] },
