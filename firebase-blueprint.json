        "contactCategory": { "type": "string", "minLength": 1, "maxLength": 80 },
        "image": { "type": "string", "minLength": 1, "maxLength": 350000 },
        "imageAlt": { "type": "string", "maxLength": 240 },
        "imageWidth": { "type": "number" },
        "imageHeight": { "type": "number" },
        "accentColor": { "type": "string", "minLength": 4, "maxLength": 20 },
        "metrics": { "type": "array" },
        "capabilities": { "type": "array" },
        "processSteps": { "type": "array" },
        "deliverables": { "type": "array" },
        "techStack": { "type": "array" },
        "idealFor": { "type": "array" },
        "faqs": { "type": "array" },
        "relatedCaseStudyId": { "type": "string", "maxLength": 128 },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "slug",
        "number",
        "group",
        "groupLabel",
        "title",
        "shortDesc",
        "offerings",
        "tagline",
        "heroTitle",
        "heroAccent",
        "heroDescription",
        "timelineLabel",
        "engagementModel",
        "contactCategory",
        "image",
        "imageAlt",
        "accentColor",
        "metrics",
        "capabilities",
        "processSteps",
        "deliverables",
        "techStack",
        "idealFor",
        "faqs",
        "sortOrder",
        "updatedAt"
      ]
    },
    "SiteProject": {
      "title": "SiteProject",
      "description": "Portfolio case study displayed on the Home and Projects showcase pages.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
