        "serviceCategory": { "type": "string", "minLength": 1, "maxLength": 100 },
        "filterCategory": {
          "type": "string",
          "enum": ["web-apps", "ai-automation", "business-tools", "ecommerce", "cloud-networking", "education-dev"]
