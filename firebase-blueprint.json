    "SiteCommunity": {
      "title": "SiteCommunity",
      "description": "Community platform or WhatsApp channel card featured on the Communities page.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "number": { "type": "string", "minLength": 1, "maxLength": 16 },
