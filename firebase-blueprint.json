    "SiteCareer": {
      "title": "SiteCareer",
      "description": "Open internship or role listed on the Careers page.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "location": { "type": "string", "minLength": 1, "maxLength": 100 },
        "department": { "type": "string", "minLength": 1, "maxLength": 100 },
