{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global company contact details, WhatsApp configuration, and availability settings rendered across the public website.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "legalName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "domain": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "phone": { "type": "string", "minLength": 5, "maxLength": 40 },
        "whatsappNumber": { "type": "string", "minLength": 8, "maxLength": 20, "pattern": "^[0-9]+$" },
        "whatsappDefaultMessage": { "type": "string", "minLength": 1, "maxLength": 300 },
        "location": { "type": "string", "minLength": 1, "maxLength": 100 },
        "regions": { "type": "string", "minLength": 1, "maxLength": 140 },
        "founded": { "type": "string", "minLength": 4, "maxLength": 20 },
        "availability": { "type": "string", "minLength": 1, "maxLength": 80 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "brandName",
        "legalName",
        "domain",
        "email",
        "phone",
        "whatsappNumber",
        "whatsappDefaultMessage",
        "location",
        "regions",
        "founded",
        "availability",
        "updatedAt"
      ]
    },
    "SiteProduct": {
      "title": "SiteProduct",
      "description": "Hardware or software kit listed in the SAMITECH Products catalog and Product Detail Page.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "sku": { "type": "string", "minLength": 1, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "category": { "type": "string", "enum": ["networking-starlink", "cctv-security", "computers-labs"] },
        "categoryLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "availability": { "type": "string", "enum": ["In Stock", "Pre-Order", "Request Quote"] },
        "pricingType": { "type": "string", "enum": ["fixed", "quote"] },
        "pricePrefix": { "type": "string", "maxLength": 30 },
        "priceAmount": { "type": "string", "minLength": 1, "maxLength": 60 },
        "unitPriceXaf": { "type": "number" },
        "shortDesc": { "type": "string", "minLength": 1, "maxLength": 400 },
        "specs": { "type": "array" },
        "heroHighlights": { "type": "array" },
        "longDescription": { "type": "string", "minLength": 1, "maxLength": 2400 },
        "aboutBullets": { "type": "array" },
        "whatsInBox": { "type": "array" },
        "image": { "type": "string", "minLength": 1, "maxLength": 350000 },
        "imageAlt": { "type": "string", "maxLength": 240 },
        "studioWhiteBg": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "featuredHighlights": { "type": "array" },
        "gallery": { "type": "array" },
        "trustStrip": { "type": "array" },
        "keyFeatures": { "type": "array" },
        "technicalSpecs": { "type": "array" },
        "includedVisuals": { "type": "array" },
        "promoBanner": { "type": "object" },
        "faqs": { "type": "array" },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "sku",
        "name",
        "category",
        "categoryLabel",
        "availability",
        "pricingType",
        "priceAmount",
        "shortDesc",
        "specs",
        "heroHighlights",
        "longDescription",
        "aboutBullets",
        "whatsInBox",
        "image",
        "imageAlt",
        "gallery",
        "trustStrip",
        "keyFeatures",
        "technicalSpecs",
        "includedVisuals",
        "promoBanner",
        "faqs",
        "sortOrder",
        "updatedAt"
      ]
    },
    "SiteService": {
      "title": "SiteService",
      "description": "SAMITECH engineering service offering, home summary card data, and Service Detail Page specifications.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "number": { "type": "string", "minLength": 1, "maxLength": 16 },
        "group": { "type": "string", "enum": ["software-teams", "networks-support", "security-tracking"] },
        "groupLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "shortDesc": { "type": "string", "minLength": 1, "maxLength": 400 },
        "offerings": { "type": "array" },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 200 },
        "heroTitle": { "type": "string", "minLength": 1, "maxLength": 140 },
        "heroAccent": { "type": "string", "minLength": 1, "maxLength": 140 },
        "heroDescription": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "timelineLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
