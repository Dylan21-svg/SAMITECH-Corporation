        "summary",
        "requirements",
        "isOpen",
        "sortOrder",
        "updatedAt"
      ]
    },
    "SiteFaq": {
      "title": "SiteFaq",
      "description": "Global frequently asked question displayed in the main Home FAQ section.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "question": { "type": "string", "minLength": 3, "maxLength": 280 },
        "answer": { "type": "string", "minLength": 3, "maxLength": 1800 },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "question", "answer", "sortOrder", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Approved Google Sign-In administrator record granting write access inside the Control Panel.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 180 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "editor"] },
        "active": { "type": "boolean" },
        "addedByEmail": { "type": "string", "minLength": 3, "maxLength": 180 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayName", "role", "active", "addedByEmail", "updatedAt"]
    },
    "SiteBackup": {
      "title": "SiteBackup",
      "description": "Admin-only project snapshot, asset manifest, and cloud sync archive record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "databaseId": { "type": "string", "minLength": 1, "maxLength": 140 },
        "storageBucket": { "type": "string", "minLength": 1, "maxLength": 160 },
        "storageSynced": { "type": "boolean" },
        "storageUrl": { "type": "string", "maxLength": 500 },
        "syncedByEmail": { "type": "string", "minLength": 3, "maxLength": 180 },
        "recordCount": { "type": "number" },
        "assetCount": { "type": "number" },
        "collections": { "type": "object" },
        "assets": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "projectName",
        "databaseId",
        "storageBucket",
        "storageSynced",
        "syncedByEmail",
        "recordCount",
        "assetCount",
        "collections",
        "assets",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/site_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global company contact details, phone, and WhatsApp settings."
    },
    "/site_products/{productId}": {
      "schema": { "$ref": "#/entities/SiteProduct" },
      "description": "Catalog hardware products, pricing, gallery images, specs, and FAQs."
    },
    "/site_services/{serviceId}": {
      "schema": { "$ref": "#/entities/SiteService" },
      "description": "Core engineering services and detail page content."
    },
    "/site_projects/{projectId}": {
      "schema": { "$ref": "#/entities/SiteProject" },
      "description": "Portfolio case studies and metrics."
    },
    "/site_team/{memberId}": {
      "schema": { "$ref": "#/entities/SiteTeamMember" },
      "description": "SAMITECH leadership and team profiles."
    },
    "/site_communities/{communityId}": {
      "schema": { "$ref": "#/entities/SiteCommunity" },
      "description": "SAMITECH web and WhatsApp community groups."
    },
    "/site_careers/{careerId}": {
      "schema": { "$ref": "#/entities/SiteCareer" },
      "description": "Open internship and career tracks."
    },
    "/site_faqs/{faqId}": {
      "schema": { "$ref": "#/entities/SiteFaq" },
      "description": "Main website frequently asked questions."
    },
    "/admin_users/{adminEmail}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin accounts allowlist for Control Panel access."
    },
    "/site_backups/{backupId}": {
      "schema": { "$ref": "#/entities/SiteBackup" },
      "description": "Admin-only full project snapshot and media asset cloud manifest."
    }
  }
}
